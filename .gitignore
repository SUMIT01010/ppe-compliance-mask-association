# --- The reason YOLO_SAM_BEVERAGE was 122MB. Do not relax these. ---
*.pt
*.pth
*.onnx
checkpoints/
runs/
datasets/
data/
# ...and the same paths as SYMLINKS. These are often symlinked out to a non-synced volume, and a
# trailing-slash pattern does NOT match a symlink - git happily commits it as a dangling link for
# whoever clones next.
checkpoints
runs
datasets
data
outputs/**/*.png
outputs/**/*.jpg

# Env
.venv/
__pycache__/
*.py[cod]

# Mac
.DS_Store

# Keep the shape of the tree
!**/.gitkeep

# Run logs (ultralytics progress bars; 1.4MB of carriage returns)
logs/
*.log
